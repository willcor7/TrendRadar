# ============================================
# Configuration du serveur web
# ============================================

# Port du serveur web (8080 par défaut, personnalisable pour éviter les conflits)
# Démarre automatiquement en mode cron, rapports accessibles via http://localhost:{WEBSERVER_PORT}
WEBSERVER_PORT=8080

# ============================================
# Configuration des canaux de notification (séparer plusieurs comptes par ;)
# ============================================

# URL webhook du bot Feishu (séparer plusieurs comptes par ;)
FEISHU_WEBHOOK_URL=
# Token du bot Telegram (séparer plusieurs comptes par ;, doit correspondre au nombre de chat_id)
TELEGRAM_BOT_TOKEN=
# Chat ID Telegram (séparer plusieurs comptes par ;, doit correspondre au nombre de bot_token)
TELEGRAM_CHAT_ID=
# URL webhook du bot DingTalk (séparer plusieurs comptes par ;)
DINGTALK_WEBHOOK_URL=
# URL webhook du bot WeCom (séparer plusieurs comptes par ;)
WEWORK_WEBHOOK_URL=
# Type de message WeCom (markdown ou text)
WEWORK_MSG_TYPE=

# Configuration e-mail (l'e-mail prend en charge plusieurs destinataires, séparés par des virgules)
EMAIL_FROM=
EMAIL_PASSWORD=
EMAIL_TO=
EMAIL_SMTP_SERVER=
EMAIL_SMTP_PORT=

# Configuration de la notification ntfy (séparer plusieurs comptes par ;, topic et token doivent être en nombre égal)
# Adresse du serveur ntfy (peut être remplacée par une instance auto-hébergée)
# Laisser vide pour utiliser https://ntfy.sh par défaut, sinon renseignez votre instance
NTFY_SERVER_URL=
# Nom du topic ntfy (séparer plusieurs comptes par ;)
NTFY_TOPIC=
# Facultatif : jeton d'accès (pour les topics privés, séparer plusieurs comptes par ;, laisser un emplacement vide sans jeton, par ex. ";token2")
NTFY_TOKEN=

# Configuration de la notification Bark (séparer plusieurs comptes par ;)
BARK_URL=

# Configuration de la notification Slack (séparer plusieurs comptes par ;)
SLACK_WEBHOOK_URL=

# Configuration Webhook générique (séparer plusieurs comptes par ;)
# Prend en charge Discord, Matrix, IFTTT et toute plateforme compatible Webhook
GENERIC_WEBHOOK_URL=
# Modèle JSON, prend en charge les placeholders {title} et {content}
# Exemple : {"content": "{content}"}
GENERIC_WEBHOOK_TEMPLATE=

# ============================================
# Configuration IA (ai_analysis et ai_translation partagent la configuration du modèle)
# ============================================

# Activer ou non l'analyse IA (true/false)
AI_ANALYSIS_ENABLED=
# Clé API IA (obligatoire, requise pour activer les fonctionnalités IA)
AI_API_KEY=
# Nom du modèle (format LiteLLM : provider/model_name)
# Exemple : deepseek/deepseek-chat, openai/gpt-4o, gemini/gemini-2.5-flash
AI_MODEL=
# Point de terminaison API personnalisé (facultatif, à laisser vide dans la plupart des cas)
AI_API_BASE=

# ============================================
# Configuration du stockage distant (protocole compatible S3, prend en charge R2/OSS/COS/S3, etc.)
# ============================================

S3_ENDPOINT_URL=
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=

# ============================================
# Configuration du MCP Server
# ============================================

# Adresse d'écoute MCP (127.0.0.1 par défaut, accès local uniquement ; passer à 0.0.0.0 pour autoriser l'accès externe)
# MCP_HOST=127.0.0.1
# Port MCP (3333 par défaut, modifiable en cas de conflit avec d'autres services)
# MCP_PORT=3333

# ============================================
# Configuration d'exécution
# ============================================

# Expression de tâche planifiée, exécution toutes les 30 minutes (par ex. à 8h, 8h30, 9h, 9h30, à intervalles réguliers)
CRON_SCHEDULE=*/30 * * * *
# Mode d'exécution : cron/once
RUN_MODE=cron
# Exécuter une fois immédiatement au démarrage
IMMEDIATE_RUN=true
