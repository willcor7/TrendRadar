FROM python:3.12-slim-bookworm

WORKDIR /app

# Copier le binaire uv depuis l'image officielle
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# Installer d'abord les dépendances (en tirant parti du cache de couches Docker)
COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-install-project --no-dev

# Copier le code du serveur MCP et le module trendradar
COPY mcp_server/ ./mcp_server/
COPY trendradar/ ./trendradar/
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-dev

ENV PATH="/app/.venv/bin:$PATH"

# Créer les répertoires nécessaires
RUN mkdir -p /app/config /app/output

ENV PYTHONUNBUFFERED=1 \
    CONFIG_PATH=/app/config/config.yaml \
    FREQUENCY_WORDS_PATH=/app/config/frequency_words.txt

# Port du service MCP HTTP (3333 par défaut, surchargeable via la variable d'environnement MCP_PORT)
ENV MCP_PORT=3333
EXPOSE 3333

# Démarrer le serveur MCP (mode HTTP)
CMD sh -c "python -m mcp_server.server --transport http --host 0.0.0.0 --port ${MCP_PORT}"
