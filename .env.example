# ───────────────────────────────────────────────────────────────
# Exemple de fichier d'environnement — copiez-le en « .env » et
# renseignez vos valeurs. Le fichier .env est chargé automatiquement
# au démarrage (python -m trendradar) et N'EST PAS committé (.gitignore).
# Priorité : variables d'environnement réelles > .env > config.yaml.
# ───────────────────────────────────────────────────────────────

# --- IA (OpenRouter) ---
# Clé API utilisée pour le filtrage, la traduction et l'analyse IA.
AI_API_KEY=

# Optionnel : certaines versions de LiteLLM privilégient cette variable
# pour le routage des modèles « openrouter/… ». Mettez la même clé si besoin.
# OPENROUTER_API_KEY=

# Optionnel : surcharger le modèle / l'endpoint sans toucher à config.yaml
# AI_MODEL=openrouter/nvidia/nemotron-3-ultra-550b-a55b:free
# AI_API_BASE=

# --- Notifications (laisser vide si non utilisé) ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# EMAIL_FROM=
# EMAIL_PASSWORD=
# EMAIL_TO=
# EMAIL_SMTP_SERVER=
# EMAIL_SMTP_PORT=

# --- Divers ---
# Langue par défaut des messages console Python (fr | en)
# UI_LANG=fr
